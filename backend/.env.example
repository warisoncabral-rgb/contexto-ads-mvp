NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://contexto_ads:contexto_ads@localhost:5432/contexto_ads
CREDENTIAL_VAULT_PROVIDER=postgres
# Gere uma vez com: openssl rand -base64 32
# Nunca armazene esta chave no Git ou no PostgreSQL.
CREDENTIAL_VAULT_MASTER_KEY=
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v26.0
# Nunca commitar credenciais reais.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3000/v1/meta/oauth/callback
# Destino server-owned para retornar à Central depois do callback OAuth.
# Em produção, use HTTPS. HTTP só é aceito em localhost para desenvolvimento.
CONTEXT_ADS_FRONTEND_BASE_URL=http://localhost:3001

# Acesso bootstrap do operador: use somente o SHA-256 de um token aleatório.
# O token em texto puro nunca deve ser salvo no Git, banco ou logs.
OPERATOR_BOOTSTRAP_SUBJECT=
OPERATOR_BOOTSTRAP_TOKEN_SHA256=
